# ============================================================================
# claude-code-remote configuration — copy to .env and edit (only .env is read;
# .env stays gitignored, this example is the committed reference).
# See README.md.
# ============================================================================


# Pins BOTH the image-baked offline-fallback seed (build time) and the
# first-boot install into ./data/local. Auto-update moves the real install
# forward afterwards, so this mainly matters for recovering from a broken
# release: pin it, wipe ./data/local, `docker compose up -d`.
CLAUDE_CODE_VERSION=latest

# Image tag: latest, an exact version (1.0.0), a major (1) or sha-<commit>.
DOCKER_CLAUDE_IMAGE_TAG=latest

TZ=UTC

# ----------------------------------------------------------------------------
# First launch (and every ~30 days after) requires an interactive OAuth login:
#   docker compose up -d --build
#   docker exec -it claude claude-login   # guided flow, copy-friendly URL
# Auth persists in ./data/claude across restarts, recreations and updates.
#
# Remote Control needs a full-scope claude.ai login (Pro/Max/Team/Enterprise).
# Never set ANTHROPIC_API_KEY or ANTHROPIC_BASE_URL here — they disable it.
# ----------------------------------------------------------------------------

# Optional: base64-encoded SSH private deploy key for git pushes.
# Generate on the host with:  base64 < deploy_key | tr -d '\n'
CLAUDE_DEPLOY_KEY_B64=

# Optional: clone a repo into /docker on first launch (only if empty).
# /docker is the host's /docker bind mount, so normally already populated.
CLAUDE_GIT_REPO=
CLAUDE_GIT_BRANCH=

# Commit identity inside the container (written to the global gitconfig, which
# is NOT persisted across recreation — repo-local config only covers /docker,
# so child containers on other repos need these).
CLAUDE_GIT_USER_NAME=
CLAUDE_GIT_USER_EMAIL=

# Permission mode for the remote-control session:
# default | acceptEdits | plan | auto | dontAsk | bypassPermissions | manual
CLAUDE_PERMISSION_MODE=acceptEdits

# Session title shown at claude.ai/code and in the mobile app.
CLAUDE_SESSION_NAME=docker-host

# Extra flags appended to `claude remote-control`, e.g.:
#   --spawn=same-dir     (new-session spawn mode: same-dir|worktree)
#   --capacity 8         (max concurrent remote sessions)
# Keep session precreation enabled for native recovery after server restarts.
# Do not add --continue or --session-id: those select single-session mode.
CLAUDE_EXTRA_ARGS=--spawn=same-dir --capacity 99

# Optional one-time setup command, tracked by ./data/claude/.init_done.
CLAUDE_INIT_COMMAND=

# Days of session transcripts to keep. Seeded into settings.json
# (cleanupPeriodDays) on first boot only — an existing value is never
# overwritten, and 0 means don't touch the file at all. The CLI's own default
# is 30 days. Longer retention preserves local history; it does not extend
# the native remote reconnect window (about four hours after stopping).
CLAUDE_TRANSCRIPT_RETENTION_DAYS=3650

# Force an interactive re-login on next start (set back to 0 afterwards).
CLAUDE_FORCE_AUTH_LOGIN=0

# claude.ai OAuth grants hard-expire ~30 days after /login (the grant's
# refreshTokenExpiresAt is absolute; token rotation does NOT extend it).
# The supervisor warns this many days ahead (log + CLAUDE_NOTIFY_URL) so you
# can re-login with zero downtime:
#   docker exec -it claude claude-login
# 0 disables the warning loop.
CLAUDE_AUTH_EXPIRY_WARN_DAYS=5

# Optional operator alerts, POSTed to this generic webhook: approaching or
# passed grant expiry and login-required outages.
# Anything that accepts an HTTP POST works — an ntfy.sh topic, a
# gotify/Slack gateway, a Home Assistant webhook, etc. Empty = off.
CLAUDE_NOTIFY_URL=

# Webhook body format:
#   text = the plain-text message as the body (ntfy-style, default)
#   json = {"source": "claude-hub", "event": "<slug>", "message": "..."}
#          (events: expiry-warning, auth-expired, login-required)
CLAUDE_NOTIFY_FORMAT=text

# ----------------------------------------------------------------------------
# Supervision / auto-update
# ----------------------------------------------------------------------------

# Hours between update checks (0 disables). The CLI also self-updates in the
# background; a running process uses its old version until restarted.
CLAUDE_UPDATE_INTERVAL_HOURS=12

# 1 = restart as soon as an update lands; 0 = wait for the next natural
# restart. Keep 0 to avoid interrupting active sessions for each update.
# Normal server restarts use Claude's native reconnect record; restoration
# is limited to eligible sessions within about four hours of stopping.
CLAUDE_UPDATE_RESTART=0

# Supervisor log verbosity: info | debug. debug adds state transitions,
# auth-check results and expiry math. Post-mortem aids regardless of level:
#   docker exec claude cat /run/claude/state-history   (state transitions)
#   docker exec claude cat /run/claude/last-stderr     (last abnormal exit)
CLAUDE_LOG_LEVEL=info

# Remote-control console in docker logs: log (default) renders it as
# ANSI-stripped, deduped '<ts> INFO [claude] …' lines readable in Portainer /
# dozzle; tui passes the raw full-screen console through unchanged (needed
# for the QR code screen over docker attach).
CLAUDE_CONSOLE=log

# Proactively restart every N hours to bound rare "process alive
# but bridge silently dead" states. 0 = disabled. Suggested: 6-12 if you ever
# see a session stop responding remotely while the container looks healthy.
CLAUDE_RECYCLE_HOURS=0

# Reconnect backoff (seconds) between relaunches.
RECONNECT_BACKOFF_MIN=5
RECONNECT_BACKOFF_MAX=180

# URL probed before (re)connecting; any HTTP response counts as reachable.
NETWORK_PROBE_URL=https://api.anthropic.com
